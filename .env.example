# คัดลอกเป็นไฟล์ .env.local (ตอนรันในเครื่อง) ส่วนบน Cloudflare ใส่ในหน้าตั้งค่า Worker

ANTHROPIC_API_KEY=sk-ant-xxxxxxxx   # ฝั่งเซิร์ฟเวอร์เท่านั้น บน Cloudflare ใส่เป็น Secret

# PostgreSQL — ใช้ทั้ง auth และข้อมูลธุรกิจ
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="เปลี่ยนเป็นค่าสุ่มของคุณเอง"
